/*
  Content-Security-Policy: default-src 'self'; connect-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; form-action 'none'; base-uri 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache

# Only the local embedded entry may be framed by the same origin.
# Its complete CSP is the first policy meta element in embed.html.
/carplan/*
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
